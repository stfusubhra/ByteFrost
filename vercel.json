{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/v1/(health|auth|listings|orders|users|matching)",
      "destination": "https://bytefrost-backend.onrender.com/api/v1/$1"
    },
    {
      "source": "/health",
      "destination": "https://bytefrost-backend.onrender.com/health"
    }
  ],
  "env": {
    "VITE_API_URL": "https://bytefrost-backend.onrender.com/api/v1"
  }
}