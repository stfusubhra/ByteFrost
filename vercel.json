{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "https://bytefrost-backend.onrender.com/api/v1/$1"
    }
  ],
  "env": {
    "VITE_API_URL": "https://bytefrost-backend.onrender.com/api/v1"
  }
}