{
  "buildCommand": "cd kisansetu && pnpm install && pnpm run build",
  "outputDirectory": "kisansetu/dist/public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://bytefrost-backend.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
